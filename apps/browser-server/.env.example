# Port the server listens on.
PORT=3001

# Shared secret that gates every request. Clients must send it in the
# `browser-server-bypass-token` header; any request with a missing or wrong
# token is answered with 404. When unset, the gate is DISABLED and all requests
# pass (useful for local dev) — always set a strong value in deployed environments.
# Generate one with: openssl rand -hex 32
# BROWSER_SERVER_BYPASS_TOKEN=

# Set to "true" to launch Chrome with --no-sandbox --disable-setuid-sandbox.
# Required when running as a non-root user without a working setuid sandbox
# (e.g. inside Docker) — see the root Dockerfile. Leave unset locally.
PUPPETEER_NO_SANDBOX=false

# Optional: path to a Chrome/Chromium binary to launch instead of the one
# Puppeteer downloads. Read directly by puppeteer, not by our own code.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Recording storage (S3) ---
# Configure these to enable start({ record: true }). When unset, recording is
# rejected with 400 "recording is not configured on this server". Credentials
# live only on the server; clients never send them.
# AWS_REGION=us-east-2
# AWS_S3_BUCKET=browser-replays
# AWS_ACCESS_KEY_ID=...      # or AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=...  # or AWS_SECRET_KEY
# Optional key prefix, e.g. "recordings/". The browser id + ".mp4" is appended.
# Where browsers run. "daytona" starts each session in its own sandbox;
# "local" runs Chrome as a child process of this server. Unset picks the first
# configured backend, preferring daytona. Pin it to fail loudly on a
# misconfigured key instead of silently falling back to local browsers.
# BROWSER_LAUNCHER=daytona

# --- Daytona (one sandbox per session, destroyed when the session ends) ---
# Running Chrome off-box is what removes this server's process-count ceiling:
# a managed host's cgroup pid limit (Railway caps at 1000, unraisable) fits only
# about three headful Chromes, and the fourth fails to fork mid-launch.
# DAYTONA_API_KEY=
# API base URL. Defaults to Daytona's cloud.
# DAYTONA_URL=https://app.daytona.io/api
# Snapshot sessions boot from. MUST contain google-chrome AND xvfb — headful is
# the default and cannot start without a display. Build one with
# `node scripts/build-daytona-snapshot.mjs <name>`.
# DAYTONA_SNAPSHOT=ob-chrome-headful
# Port Chrome listens for CDP on inside the sandbox.
# DAYTONA_CDP_PORT=9222
# Safety net for sandboxes orphaned by a server crash — the normal teardown
# deletes them outright. Minutes of idleness before Daytona stops one.
# DAYTONA_AUTO_STOP_MINUTES=15

# Memory the in-process context-snapshot cache may hold, in bytes. Snapshot keys
# are versioned and never overwritten, so cached bytes need no invalidation.
# CONTEXT_CACHE_BYTES=67108864
